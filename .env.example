WHATSAPP_PHONE_ID=YOUR_PHONE_NUMBER_ID
WHATSAPP_API_TOKEN=YOUR_META_ACCESS_TOKEN
# Meta App secret (App → Settings → Basic). Used to verify webhook signatures.
# If unset, signature verification is skipped (logged) so the webhook keeps working.
META_APP_SECRET=YOUR_META_APP_SECRET
ANTHROPIC_API_KEY=sk-ant-YOUR_KEY
MANAGER_PHONE=+972546408547
WEBHOOK_VERIFY_TOKEN=choose_a_random_secret_string
PORT=3000
